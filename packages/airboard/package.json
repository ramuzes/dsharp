{
  "name": "dsh-airboard",
  "version": "0.2.0",
  "description": "AirBoard reader for the dsh web GUI: a right-Sidebar tab browsing ADR/PRD/SPEC/PLAN/ISSUE markdown over a Host-side read-only proxy",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "lib"
  ],
  "scripts": {
    "test": "node --test \"tests/*.spec.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1"
  }
}
