{
  "name": "dsh-feishu-gateway",
  "version": "0.1.0",
  "description": "Feishu (Lark) bot gateway for dsh: p2p messages drive bound workspace sessions; questions/approvals round-trip as interactive cards",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "lib", "client.js", "cordis.patch.yml", "README.md", "README.zh-CN.md", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test \"tests/*.spec.js\"" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": { "@larksuiteoapi/node-sdk": "^1.74.0", "zod": "^4.4.3" },
  "peerDependencies": { "@deepseek-ai/schemastery": "*", "@deepseek-ai/dsh-storage-domain": "*" },
  "devDependencies": { "@deepseek-ai/schemastery": "*" }
}
